# ===========================================================================
# FluxCoin — root environment. Copy to `.env` and fill in.
#   PowerShell:  Copy-Item .env.example .env
# The frontend (Vite) reads the VITE_* values, Hardhat reads the rest.
# NEVER commit the filled .env (it holds private keys).
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Frontend — API + chain wiring
# ---------------------------------------------------------------------------
VITE_API_URL=https://fluxcoin.codexstechnology.workers.dev
# Chain the Flash contracts live on: 137 = Polygon (PRODUCTION), 11155111 = Sepolia (testing)
VITE_NETWORK_ID=137
# Per-asset FlashToken contracts — filled by `contracts/scripts/deployFlashAssets.js`
# (run from contracts/). Each asset has its OWN contract:
VITE_TOKEN_ADDRESS_USDT=
VITE_TOKEN_ADDRESS_BTC=
VITE_TOKEN_ADDRESS_ETH=
VITE_TOKEN_ADDRESS_TRX=
VITE_TOKEN_ADDRESS_SOL=
# Legacy single FLUX token (optional, only if you also deploy contracts/scripts/deploy.js)
VITE_TOKEN_ADDRESS=
VITE_FAUCET_ADDRESS=
VITE_TOKEN_SYMBOL=USDT
# Optional DEX router override (defaults per chain live in src/contracts/addresses.js)
VITE_ROUTER_ADDRESS=

# ---------------------------------------------------------------------------
# 2. ★★★ WalletConnect / Reown AppKit project id ★★★
#    Free: https://dashboard.reown.com  (formerly cloud.walletconnect.com)
#    Without it, extension wallets still work; the QR/AppKit modal shows a hint.
# ---------------------------------------------------------------------------
VITE_WALLETCONNECT_PROJECT_ID=YOUR_REOWN_PROJECT_ID
VITE_APP_NAME=FluxCoin
VITE_APP_URL=http://localhost:5173
VITE_APP_ICON=

# ---------------------------------------------------------------------------
# 3. RPC endpoints (used for read-only calls + chain metadata)
# ---------------------------------------------------------------------------
VITE_RPC_11155111=https://rpc.sepolia.org
VITE_RPC_1=https://eth.llamarpc.com
VITE_RPC_56=https://bsc-dataseed.binance.org
VITE_RPC_97=https://data-seed-prebsc-1-s1.binance.org:8545
VITE_RPC_137=https://polygon-rpc.com

# Optional: bundler URL for the ERC-4337 path (the paymaster URL stays in api/.env)
VITE_BICONOMY_BUNDLER_URL=

# ---------------------------------------------------------------------------
# 4. Contracts (Hardhat) — deployment
# ---------------------------------------------------------------------------
RPC_URL_SEPOLIA=https://rpc.sepolia.org
RPC_URL_BSC=https://bsc-dataseed.binance.org
RPC_URL_BSC_TESTNET=https://data-seed-prebsc-1-s1.binance.org:8545
RPC_URL_POLYGON=https://polygon-rpc.com
RPC_URL_MAINNET=https://eth.llamarpc.com

# Deployer key (pays deployment gas) — use a throwaway/dev key.
DEPLOYER_PRIVATE_KEY=
# Addresses that receive roles after deployment:
TOKEN_ADMIN_ADDRESS=
BACKEND_MINTER_ADDRESS=
# Address of the key in api/.env BACKEND_SIGNER_PRIVATE_KEY (gets SIGNER_ROLE on FluxFaucet)
BACKEND_SIGNER_ADDRESS=
# Gelato's trusted forwarder (default: 0xd8253782c45a12053594b9deB72d8e8aB2Fca54c)
GELATO_TRUSTED_FORWARDER=

INITIAL_SUPPLY=100000000
MAX_SUPPLY=1000000000
MAX_CLAIM_TOKENS=100000

# Liquidity seeding (contracts/scripts/addLiquidity.js)
LP_TOKEN_AMOUNT=100000
LP_NATIVE_AMOUNT=0.1
LP_SLIPPAGE_BPS=500

# Contract verification (optional)
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
