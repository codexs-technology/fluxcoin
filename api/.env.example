# ---------------------------------------------------------------------------
# FluxCoin API (backend) configuration  --  copy to api/.env and fill in
# ---------------------------------------------------------------------------
PORT=8787
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Chain / contract -------------------------------------------------------
CHAIN_ID=11155111
RPC_URL=https://rpc.sepolia.org
TOKEN_ADDRESS=
FAUCET_ADDRESS=

# --- Backend wallets -------------------------------------------------------
# MINTER_PRIVATE_KEY: hot wallet that holds MINTER_ROLE on FluxCoin.
#                      Used by GASLESS_MODE=server (backend pays the gas).
MINTER_PRIVATE_KEY=

# BACKEND_SIGNER_PRIVATE_KEY: holds SIGNER_ROLE on FluxFaucet and signs the
#                              EIP-712 withdrawal authorizations.
BACKEND_SIGNER_PRIVATE_KEY=

# --- Gasless (zero-fee for users) -------------------------------------------
# GASLESS_MODE:
#   gelato   -> Gelato Relay ERC-2771 relayer pays the gas (recommended, low setup)
#   biconomy -> ERC-4337 UserOperation sponsored by your Biconomy Paymaster
#               (the API signs the authorization + proxies paymaster sponsorship)
#   server   -> backend hot wallet mints directly; user never sends a tx
GASLESS_MODE=server

# ★★★ PUT YOUR GELATO API KEY HERE ★★★ (https://app.gelato.network -> 1Balance / Relay)
GELATO_RELAY_API_KEY=
GELATO_SPONSOR_API_KEY=

# ★★★ PUT YOUR BICONOMY PAYMASTER API KEYS HERE ★★★ (https://dashboard.biconomy.io)
BICONOMY_PAYMASTER_API_KEY=
BICONOMY_PAYMASTER_URL=https://paymaster.biconomy.io/api/v2/11155111/YOUR_PAYMASTER_ID
BICONOMY_BUNDLER_URL=https://bundler.biconomy.io/api/v2/11155111/YOUR_BUNDLER_ID

# --- Limits / anti-abuse (server-side enforced, never trust the client) -----
EARN_MIN_TOKENS=1
EARN_MAX_TOKENS=100000
EARN_COOLDOWN_SECONDS=20
EARN_DAILY_CAP_TOKENS=500000

WITHDRAW_MIN_TOKENS=1
WITHDRAW_MAX_TOKENS=100000
WITHDRAW_DAILY_CAP_TOKENS=1000000

# --- Session signing --------------------------------------------------------
SESSION_SECRET=change-me-to-a-long-random-string

# --- Safety -----------------------------------------------------------------
# ALLOW_DRY_RUN=true lets the API run without a funded key/RPC: withdrawals are
# validated and recorded, and the on-chain step is simulated locally.
ALLOW_DRY_RUN=true
