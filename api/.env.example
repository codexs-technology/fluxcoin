# ============================================================================
# FluxCoin API (Cloudflare Worker) — configuration
# ============================================================================
# The Worker is configured in TWO places, both at the repository root:
#
#   1. wrangler.jsonc  -> "vars"     (public, committed)
#   2. wrangler secrets -> private   (npx wrangler secret put NAME)
#
# For LOCAL development Wrangler reads `api/.dev.vars` (git-ignored) instead of
# secrets. Copy the block below into `api/.dev.vars` only if you need real keys
# locally; the Worker boots and answers /api/health without any of them.
# ============================================================================
# --- session ---------------------------------------------------------------
# Signs the stateless session tokens. Long random string, never committed.
#   npx wrangler secret put SESSION_SECRET
SESSION_SECRET=

# --- gasless settlement ----------------------------------------------------
# GASLESS_MODE:
#   auto      -> PAYMASTER_URL if set, else the sponsor wallet, else dry-run
#   paymaster -> ERC-4337 sponsored UserOperation (needs PAYMASTER_URL)
#   server    -> the project wallet mints/transfers and pays the gas
#   dry-run   -> validated + booked as SIMULATED, nothing broadcast
#   (in wrangler.jsonc -> vars)

# ERC-4337 bundler + paymaster endpoint (Pimlico/Alchemy/Infura, v0.7 EntryPoint)
PAYMASTER_URL=

# Project sponsor wallet: owner of the smart account and holder of MINTER_ROLE
# on FluxCoin. Without it the `server` and `paymaster` routes stay disabled.
MINTER_PRIVATE_KEY=

# --- chain / contracts -----------------------------------------------------
# (in wrangler.jsonc -> vars; the addresses are printed by
#  contracts/scripts/deploy.js)
CHAIN_ID=11155111
RPC_URL=https://rpc.chainlist.io/sepolia
TOKEN_ADDRESS=
FAUCET_ADDRESS=

# --- safety ----------------------------------------------------------------
# true  -> an unconfigured Worker still validates and books withdrawals
#          (status SIMULATED) instead of returning 503
# false -> withdrawals are refused until a paymaster/sponsor wallet is set
ALLOW_DRY_RUN=true

# --- limits / anti-abuse (server-side enforced, never trust the client) ----
EARN_MIN_TOKENS=1
EARN_MAX_TOKENS=100000
EARN_COOLDOWN_SECONDS=20
EARN_DAILY_CAP_TOKENS=500000

WITHDRAW_MIN_TOKENS=1
WITHDRAW_MAX_TOKENS=100000
WITHDRAW_DAILY_CAP_TOKENS=1000000

# --- session lifetime ------------------------------------------------------
SESSION_TTL_MINUTES=1440
AUTH_NONCE_TTL_SECONDS=300

# --- CORS ------------------------------------------------------------------
# Comma separated list of frontend origins, or "*" to allow any.
CORS_ORIGINS=https://fluxcoin.pages.dev,http://localhost:5173,http://127.0.0.1:5173
