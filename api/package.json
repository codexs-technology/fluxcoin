{
  "name": "fluxcoin-api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "FluxCoin API: a Cloudflare Worker (Hono) serving the earned-balance ledger and gasless FLUX withdrawals",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.jsonc",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "wrangler deploy --config ../wrangler.jsonc --dry-run --outdir api/dist",
    "deploy": "wrangler deploy --config ../wrangler.jsonc",
    "test:flow": "node scripts/flow-test.mjs"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "permissionless": "^0.4.1",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.141.0"
  }
}
