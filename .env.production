# ===========================================================================
# FluxCoin — production environment (Vite, `npm run build`)
#
# Loaded automatically by `vite build` (and therefore by the Cloudflare Pages
# build). This is the ONLY value the deployed frontend needs to reach the API.
# ===========================================================================

# The FluxCoin API Cloudflare Worker (wrangler.jsonc -> "name": "fluxcoin").
# It must serve /api/* JSON — the frontend itself is served by Cloudflare Pages.
VITE_API_URL=https://fluxcoin.codexstechnology.workers.dev
